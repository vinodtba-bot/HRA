# Copy to .env for local dev. In AWS these come from Secrets Manager, never from a committed file.
DATABASE_URL=postgresql://hra:hra@localhost:5432/hra

# 32+ random bytes each, e.g. `openssl rand -base64 48`
TOKEN_PEPPER=change-me-token-pepper
DOB_PEPPER=change-me-identity-pepper
SESSION_SECRET=change-me-session-secret

# Branded short domain the SMS links use (no trailing slash)
PUBLIC_LINK_BASE=http://localhost:3000
PLAN_NAME=Sunrise Health Plan
PLAN_NURSE_LINE=1-800-555-0100

# Twilio. Leave blank to use the console stub (SMS written to .dev-outbox.log).
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# Admin page login on your laptop. In AWS the admin page uses a Cognito login with MFA instead (ADMIN_AUTH=alb).
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Set to 1 only for local dev to skip quiet hours when sending
IGNORE_QUIET_HOURS=0

# Local testing only: use the console SMS stub even in a production build
SMS_STUB=0

# AWS only (set by infra/, leave blank locally): encrypted bucket for exports and imports, and the crisis alert topic.
# Blank means exports go to ./exports and crisis alerts are only logged.
DATA_BUCKET=
CRISIS_ALERT_TOPIC_ARN=
